# Imagem de producao do web (Next.js, saida standalone).
# NEXT_PUBLIC_API_URL e embutido no bundle em build-time: mudar a URL da API exige
# rebuild da imagem (--build-arg NEXT_PUBLIC_API_URL=...). Limitacao conhecida.
# O standalone copia so o necessario; em monorepo o server.js fica em
# apps/web/server.js dentro de .next/standalone.
FROM node:24-slim AS construtor
ENV CI=true NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://localhost:3333
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN corepack enable
WORKDIR /repo
COPY . .
RUN corepack pnpm install --frozen-lockfile \
 && corepack pnpm --filter @bastion/web build

FROM node:24-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=construtor --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=construtor --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=construtor --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
