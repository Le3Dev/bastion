{
  "name": "@bastion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/servidor.ts",
    "start": "node dist/servidor.js",
    "build": "tsup",
    "start:tsx": "tsx --env-file-if-exists=../../.env src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "banco:gerar": "drizzle-kit generate",
    "banco:migrar": "tsx --env-file-if-exists=../../.env scripts/migrar.ts",
    "banco:migrar:teste": "tsx --env-file-if-exists=../../.env scripts/migrar.ts --teste",
    "banco:semear": "tsx --env-file-if-exists=../../.env scripts/semear.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@bastion/contratos": "workspace:*",
    "@bastion/dominio-compartilhado": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.7.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
