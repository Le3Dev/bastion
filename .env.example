# Valores SÓ de desenvolvimento. Copie para .env (cp .env.example .env).

# --- Banco (PostgreSQL) ---
# Aplicação: papel bastion_app (sem BYPASSRLS). Migração: papel bastion_migrador (dono das tabelas).
DATABASE_URL=postgres://bastion_app:app_dev@localhost:5432/bastion
DATABASE_URL_MIGRACAO=postgres://bastion_migrador:migrador_dev@localhost:5432/bastion
# Banco usado pelos testes de integração
DATABASE_URL_TESTE=postgres://bastion_app:app_dev@localhost:5432/bastion_teste
DATABASE_URL_TESTE_MIGRACAO=postgres://bastion_migrador:migrador_dev@localhost:5432/bastion_teste

# --- Redis (fila BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Armazenamento compatível com S3 (RustFS no dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGIAO=us-east-1
S3_CHAVE_DE_ACESSO=bastion
S3_SEGREDO=bastion_dev_segredo
S3_BUCKET_RELATORIOS=bastion-relatorios

# --- API ---
API_PORTA=3333
API_ORIGEM_WEB=http://localhost:3000
# Em produção (HTTPS), use true
SESSAO_COOKIE_SEGURO=false
SESSAO_DURACAO_HORAS=12

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Guardião de Escopo ---
# SÓ dev, para o alvo de teste local (rede privada). PROIBIDO em produção.
GUARDIAO_PERMITIR_REDES_PRIVADAS=true
GUARDIAO_REQUISICOES_POR_SEGUNDO=5
