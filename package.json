{
  "name": "bastion-plataforma",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "infra:subir": "docker compose up -d --wait",
    "infra:parar": "docker compose down",
    "banco:gerar": "pnpm --filter @bastion/api banco:gerar",
    "banco:migrar": "pnpm --filter @bastion/api banco:migrar",
    "banco:semear": "pnpm --filter @bastion/api banco:semear"
  }
}
